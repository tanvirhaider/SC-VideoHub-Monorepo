# Production tracking config, read at build time by shared/js/tracking.
# `npm run dev` layers .env.development over this file.

# Matomo Tag Manager (ZenithAnalytics) — production container.
# MatomoAdapter injects https://$VITE_MTM_HOST/js/container_$VITE_MTM_CONTAINER.js
VITE_MTM_HOST=analytics.sharecare.com
VITE_MTM_CONTAINER=KpatjL22

# Adobe Launch (DTM) — production library. Previously hard-coded in index.html.
VITE_ADOBE_DTM_URL=https://assets.adobedtm.com/7b7e1e4c7d6a/dd53eedb46ba/launch-7b16fe6219ef.min.js

# GA4 measurement ID. Previously hard-coded in index.html.
VITE_GA4_ID=G-RT7YJZ67KM
